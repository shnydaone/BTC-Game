extends SceneTree
## Plays every bot through Acts 1-2 headless and writes CSVs (GDD 14).
##
##   godot --headless --path . --script res://tests/sim/run_bots.gd
##   godot --headless --path . --script res://tests/sim/run_bots.gd -- --seeds 10 --modes slashdot,late
##
## Output goes to tests/sim/out/ (gitignored): one daily CSV per bot, mode and seed,
## summary.csv, and laptop_whale.md (the 2009 stack report).

const OUT_DIR: String = "res://tests/sim/out/"
const DEFAULT_SEEDS: int = 5
const DEFAULT_MODES: PackedStringArray = ["slashdot", "cypherpunk", "late"]
const WHALE_CHECKPOINTS: PackedStringArray = [
	"2009-12-31", "2010-07-18", "2010-12-31", "2011-06-08", "2011-11-18", "2012-11-28", "2013-12-04", "2014-02-07", "2015-01-14", "2016-07-09",
]
const SUMMARY_COLUMNS: PackedStringArray = [
	"bot", "mode", "seed", "score_usd", "act1_grade", "act2_grade", "survived", "restructured_on", "payments_missed",
	"objective_met_on", "exchange_losses_btc", "final_btc", "seconds",
]


func _init() -> void:
	var args: Dictionary = _parse(OS.get_cmdline_user_args())
	var seeds: int = int(args.get("seeds", DEFAULT_SEEDS))
	var modes: PackedStringArray = String(args["modes"]).split(",") if args.has("modes") else DEFAULT_MODES
	var out: String = ProjectSettings.globalize_path(OUT_DIR)
	DirAccess.make_dir_recursive_absolute(out)
	# Keep Godot from importing the CSVs as translations.
	FileAccess.open(out + ".gdignore", FileAccess.WRITE).close()

	var summary: PackedStringArray = [",".join(SUMMARY_COLUMNS)]
	for mode_id: String in modes:
		for seed_value: int in range(1, seeds + 1):
			for bot: Bot in BotRunner.all_bots():
				var r := BotRunner.run(bot, mode_id, seed_value)
				_write(out + "%s_%s_%d.csv" % [r.bot, mode_id, seed_value], r.csv_text())
				summary.append(_summary_row(r))
				print("%-15s %-10s seed %2d  score $%14s  grades %s/%s  %s  %.2fs" % [
					r.bot, mode_id, seed_value, "%.0f" % r.score_usd(), r.card(1).get("grade", "-"), r.card(2).get("grade", "-"),
					"survived" if r.survived() else "restructured %s" % ",".join(r.restructured_on), r.seconds])
	_write(out + "summary.csv", "\n".join(summary) + "\n")
	_write(out + "laptop_whale.md", whale_report())
	print("Wrote %s" % out)
	quit()


static func _summary_row(r: BotRunner.Run) -> String:
	var last: int = r.dates.size() - 1
	return ",".join([
		r.bot, r.mode, str(r.seed_value), "%.2f" % r.score_usd(), r.card(1).get("grade", ""), r.card(2).get("grade", ""),
		str(r.survived()), " ".join(r.restructured_on), str(r.payments_missed), r.objective_met_on,
		"%.8f" % (r.exchange_losses_sats / 1.0e8), "%.8f" % ((r.cold_sats[last] + r.exchange_sats[last]) / 1.0e8), "%.3f" % r.seconds,
	])


## What a laptop (and a laptop plus a desktop) left mining from Genesis holds, and how
## long the thin early market would take to absorb it.
static func whale_report() -> String:
	var data := GameData.shared()
	var h: History = data.history
	var cap: float = float(data.tuning("market", "sell_cap_fraction_of_volume"))
	var lines: PackedStringArray = [
		"# Laptop Whale report",
		"",
		"Generated by `tests/sim/run_bots.gd`. Cypherpunk mode, seed 1, solo mining, never sells, every coin in cold storage.",
		"Equity is cash plus BTC at the close plus hardware at book. \"Days to sell\" is how long selling the whole stack would take at the daily cap (%d%% of that day's real exchange volume), holding the stack and volume fixed." % roundi(cap * 100.0),
		"",
	]
	for bot: LaptopWhaleBot in [LaptopWhaleBot.new(false), LaptopWhaleBot.new(true)]:
		var r := BotRunner.run(bot, "cypherpunk", 1)
		lines.append("## %s" % ("Laptop only" if not bot.with_desktop else "Laptop plus one desktop"))
		lines.append("")
		lines.append("| Date | BTC held | Close | Equity | Days to sell at the cap |")
		lines.append("|---|---|---|---|---|")
		for date: String in WHALE_CHECKPOINTS:
			var i: int = r.dates.find(date)
			if i < 0:
				continue
			var held: float = (r.cold_sats[i] + r.exchange_sats[i]) / 1.0e8
			var day: int = h.index_of(date)
			var close: String = "none" if not h.has_price(day) else "$" + String.num(h.price_usd[day], 4 if h.price_usd[day] < 1.0 else 2)
			var vol: float = h.volume_btc[day] * cap
			var days_to_sell: String = "no market" if vol <= 0.0 else "%d" % ceili(held / vol)
			lines.append("| %s | %s | %s | $%s | %s |" % [date, _thousands(held), close, _thousands(r.equity_cents[i] / 100.0), days_to_sell])
		lines.append("")
	return "\n".join(lines) + "\n"


static func _thousands(x: float) -> String:
	var s: String = "%d" % roundi(x)
	var out: String = ""
	var digits: int = 0
	for i: int in range(s.length() - 1, -1, -1):
		if digits > 0 and digits % 3 == 0 and s[i] != "-":
			out = "," + out
		out = s[i] + out
		digits += 1
	return out


static func _parse(argv: PackedStringArray) -> Dictionary:
	var d: Dictionary = {}
	var i: int = 0
	while i < argv.size():
		if argv[i].begins_with("--") and i + 1 < argv.size():
			d[argv[i].substr(2)] = argv[i + 1]
			i += 2
		else:
			i += 1
	return d


static func _write(path: String, text: String) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(text)
	f.close()
